# 映库多模态素材平台｜本地配置（中文说明）
# 实际使用 .env；.env.example 只是空白模板，不要在模板里填写真实密钥。
# 只改每行等号右边的值，左边英文变量名是程序使用的名称，不要翻译或删除。
# 不需要把密钥发到聊天里；本地 .env 已被 Git 忽略。
#
# 【先确认你买的 Token Plan】
# Token Plan 有专属 Key（通常以 sk-sp- 开头）和专属服务地址。
# 如果是个人版，官方限定用于指定开发工具中的交互式开发，不适用于本项目后台自动处理。
# 聊天密钥和地址必须成套使用；实际 .env 中你已填入的聊天配置会保留。
# 已实测你的 Token Plan 地址可调用聊天；套餐适用范围与调用可达性分别核验。
# 如果买的是团队版，先告知版本，再核对适用方式；本配置不默认使用团队套餐额度。
# 文本向量改用硅基流动 BGE-M3；Token Plan语音接口已实测可用，图文向量另行核验。
# 说明与官方来源：docs/setup/cloud-configuration.md

# ==================== 一、聊天配置：保留你原来填写的值 ====================

# 【已填写可保留】聊天服务密钥；必须与下面的聊天服务地址配套。
# 你已填入的真实密钥不会被这次新增的向量配置替换。
DASHSCOPE_API_KEY=

# 【确认地域】与上面聊天服务的 Key 和地址所属地域一致；已测北京配置保持原值。
DASHSCOPE_REGION=cn-beijing

# 【可选】仅使用特定业务空间时填写空间 ID；默认空间先留空。
DASHSCOPE_WORKSPACE_ID=

# 【已填写可保留】聊天服务的 API Base URL，不是网页控制台网址。
# 当前 .env 已填写并测试过的 Token Plan 地址继续保留。
DASHSCOPE_BASE_URL=

# ==================== 二、硅基流动 BGE-M3：你现在填这里 ====================

# 【不用改】文本向量服务商，独立于上面的聊天服务。
TEXT_EMBEDDING_PROVIDER=siliconflow
# 【现在只需填这一项】硅基流动控制台“API 密钥”中的 Key，粘贴在等号后。
# 此处填写硅基流动的 Key，不填写阿里云 Token Plan 的 Key。
TEXT_EMBEDDING_API_KEY=
# 【已填好】硅基流动中国站兼容接口，末尾保留 /v1，不手动再加 /embeddings。
TEXT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 【已填好】BGE-M3 完整模型 ID，大小写和斜杠保持一致。
# 如果你控制台选的是 Pro/BAAI/bge-m3，请改成该完整 ID；不会自动切换收费模型。
TEXT_EMBEDDING_MODEL=BAAI/bge-m3
# 【不要改】维度与数据库索引绑定，换维度需要迁移并重新建立索引。
TEXT_EMBEDDING_DIMENSION=1024
# BGE-M3 处理文档、OCR、图片描述和音视频转写的文本，不直接处理图片像素。

# ==================== 三、其他模型：先保留，后续逐项核验 ====================

# 【候选，未接通】图文向量用于以文搜图、以图搜图、视频画面检索，独立于 BGE-M3。
VISUAL_EMBEDDING_MODEL=tongyi-embedding-vision-plus-2026-03-06
# 【不要改】视觉向量独立使用 1152 维，不与文本向量混用。
VISUAL_EMBEDDING_DIMENSION=1152

# 【不用改】图片理解模型：生成图片/视频代表帧的描述和候选标签。
VISION_MODEL=qwen3-vl-flash
# 【已实测，不用改】Token Plan录音转写模型，返回识别文字与词级时间戳。
# 语音识别使用同一Token Plan账号密钥，但原生语音接口与聊天地址不同，由适配器处理。
# 单次输入上限5分钟；长音视频需要分段和时间戳合并，尚待完整链路验收。
ASR_MODEL=qwen-audio-3.0-asr-flash
# 【已实测】聊天/问答模型；qwen3.7-plus已返回200，旧qwen-plus在当前套餐不可用。
ANSWER_MODEL=qwen3.7-plus
# 上述模型是当前候选；账号/地域不可用时，我会先核验并调整，不自动换成其他计费通道。

# ==================== 四、本地运行配置：我已处理，先不用改 ====================

# 开发环境；公开部署时再配置生产环境与 HTTPS。
APP_ENV=development
# 新项目独立数据库账号，不读取旧 AI-DMP 数据库。
POSTGRES_USER=atlas
# 实际 .env 已生成随机数据库密码；模板这里留空。
POSTGRES_PASSWORD=
# 独立数据库名称。
POSTGRES_DB=media_atlas
# 本机数据库端口，避免与已有项目冲突。
POSTGRES_PORT=15433
# 实际 .env 已填写本项目数据库连接，先不用改。
DATABASE_URL=
# 实际 .env 已填写专用测试库连接；测试库名必须以 _test 结尾。
TEST_DATABASE_URL=
# 本项目 Redis 地址。
REDIS_URL=redis://127.0.0.1:16380/0
# 实际 .env 已生成随机会话密钥，先不用改。
SESSION_SECRET=
# 本地初始管理员用户名。
BOOTSTRAP_ADMIN_USERNAME=admin
# 实际 .env 已生成随机初始密码；服务启动后用该值登录。
BOOTSTRAP_ADMIN_PASSWORD=

# ==================== 五、火山引擎 TOS：现在填写以下五项 ====================

# 【不用改】素材存储方式，图片、文档、音频、视频都放在私有TOS桶。
STORAGE_BACKEND=tos
# 【需要填写1/5】火山引擎访问密钥AccessKey ID，配套填写下面的SecretKey。
# 建议使用项目专用IAM用户，授权对应桶/前缀的对象上传、读取、列举、删除。
TOS_ACCESS_KEY=
# 【需要填写2/5】与上面AccessKey ID配对的Secret Access Key，不是账号登录密码。
TOS_SECRET_KEY=
# 【需要填写3/5】桶实际所属地域。如桶建在华北2（北京），此处填cn-beijing。
# 其他地域以控制台实际值为准，不按个人居住地填写。
TOS_REGION=
# 【需要填写4/5】桶所属地域的公网Endpoint，不填网页控制台或包含桶名的对象URL。
# 北京地域示例：https://tos-cn-beijing.volces.com
# 本机联调用公网Endpoint，不填仅云内网可达的地址。
TOS_ENDPOINT=
# 【需要填写5/5】存储桶名称。创建时选择：标准存储、私有访问。
# 建议新建本项目专用桶；名称可自行取，控制台提示占用时更换后缀。
TOS_BUCKET=
# 【已填好，不用改】本项目独立对象前缀；联调只在此前缀下创建自己的测试对象。
TOS_PREFIX=media-atlas/development/

# ==================== 六、联调范围：保持当前值 ====================
# 已授权先跑 4 个小样；只有配置完成并确认接口适用后才执行。
CLOUD_SMOKE_MAX_ASSETS=4
# 批量 AI 处理保持关闭，不因填好密钥而自动批量调用。
CLOUD_BULK_ENABLED=false
